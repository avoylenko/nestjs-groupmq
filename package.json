{
  "name": "@avoylenko/nestjs-groupmq",
  "version": "0.1.0",
  "description": "NestJS module for groupmq - per-group FIFO Redis queues, in the style of @nestjs/bullmq",
  "homepage": "https://github.com/avoylenko/nestjs-groupmq#readme",
  "bugs": {
    "url": "https://github.com/avoylenko/nestjs-groupmq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avoylenko/nestjs-groupmq.git"
  },
  "license": "MIT",
  "author": "Anton Voylenko",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nestjs",
    "groupmq",
    "queue",
    "redis",
    "fifo",
    "jobs",
    "worker"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "test:e2e:dev": "vitest --config vitest.config.e2e.mts",
    "example:start": "ts-node --transpile-only --project examples/tsconfig.json examples/main.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "groupmq": "^1.0.0",
    "ioredis": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.21",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "@nestjs/testing": "11.1.21",
    "@swc/core": "^1.15.43",
    "@types/node": "24.12.4",
    "groupmq": "1.1.0",
    "ioredis": "5.4.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
